{
    "manifest_version": 3,
    "name": "Canal de YouTube a TXT | Maximus",
    "version": "3.1.0",
    "description": "Descarga transcripciones de canales, videos y Shorts de YouTube en TXT por bloques de 200 caracteres y árbol ASCII en ZIP (con rescate Audio-a-TXT Whisper).",
    "author": "tivp",
    "icons": {
        "16": "Transfomer Logo.png",
        "48": "Transfomer Logo.png",
        "128": "Transfomer Logo.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "Transfomer Logo.png",
        "default_title": "Canal de YouTube a TXT | Maximus"
    },
    "permissions": [
        "clipboardWrite",
        "notifications",
        "offscreen",
        "storage",
        "scripting",
        "tabs",
        "userScripts"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*",
        "https://*.googlevideo.com/*",
        "https://raw.githubusercontent.com/*",
        "https://api.github.com/*",
        "https://api.groq.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://huggingface.co/*",
        "https://*.huggingface.co/*",
        "https://*.hf.co/*",
        "https://*.hf.space/*",
        "https://cdn.jsdelivr.net/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://m.youtube.com/*"
            ],
            "js": [
                "page-hook.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true
        },
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://m.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "modules/*.js",
                "Transfomer Logo.png",
                "Transfomer Logo.svg"
            ],
            "matches": [
                "https://www.youtube.com/*",
                "https://m.youtube.com/*"
            ]
        }
    ]
}
